{
  "name": "create-sst-aws-app",
  "version": "0.1.0",
  "description": "Scaffold an SST v3 project on AWS with production-grade patterns (Cognito + KMS auth, multi-tenancy, GitHub OIDC)",
  "type": "module",
  "bin": {
    "create-sst-aws-app": "./dist/bin.js"
  },
  "files": ["dist", "LICENSE", "README.md"],
  "keywords": [
    "sst",
    "aws",
    "scaffolding",
    "starter",
    "cognito",
    "dynamodb",
    "cloudfront",
    "kms",
    "multi-tenant",
    "oidc",
    "github-actions",
    "create-app"
  ],
  "author": "Matthew Higley <matt@codecompletemedia.com>",
  "license": "MIT",
  "homepage": "https://github.com/codecompletemedia/create-sst-aws-app#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codecompletemedia/create-sst-aws-app.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/codecompletemedia/create-sst-aws-app/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/bin.ts --format esm --target node20 --outDir dist --clean",
    "dev": "tsup src/bin.ts --format esm --watch --outDir dist",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm -w build"
  },
  "dependencies": {
    "cac": "^6.7.14",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "@aws-sdk/client-iam": "^3.787.0",
    "@aws-sdk/client-sts": "^3.787.0",
    "@aws-sdk/client-s3": "^3.787.0",
    "@aws-sdk/credential-providers": "^3.787.0",
    "fastify": "^5.0.0",
    "@fastify/static": "^8.0.0",
    "archiver": "^7.0.0",
    "open": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/prompts": "^2.4.9",
    "@types/archiver": "^6.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.2"
  }
}
