{
  "name": "easy-aws-deploy",
  "version": "0.1.0",
  "description": "CLI to scaffold SST v3 projects with production-grade AWS patterns",
  "type": "module",
  "bin": {
    "easy-aws-deploy": "./dist/bin.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/bin.ts --format esm --target node20 --outDir dist --clean",
    "dev": "tsup src/bin.ts --format esm --watch --outDir dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cac": "^6.7.14",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "@aws-sdk/client-iam": "^3.787.0",
    "@aws-sdk/client-sts": "^3.787.0",
    "@aws-sdk/client-s3": "^3.787.0",
    "@aws-sdk/credential-providers": "^3.787.0",
    "fastify": "^5.0.0",
    "@fastify/static": "^8.0.0",
    "archiver": "^7.0.0",
    "open": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/prompts": "^2.4.9",
    "@types/archiver": "^6.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.2"
  }
}
